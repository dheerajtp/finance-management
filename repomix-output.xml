    <ConfirmModal
      isOpen={isLogoutConfirmOpen}
      onClose={onCancelLogout}
      onConfirm={onConfirmLogout}
      title="Log out?"
      message="Are you sure you want to log out?"
      confirmLabel="Log out"
      variant="danger"
      loading={loggingOut}
    />
  </div>
)

export default SecuritySettings
