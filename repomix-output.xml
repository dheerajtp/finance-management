          otherAccountGroups={otherAccountGroups}
          metrics={metrics}
          currency={currency}
          periodLabel={periodLabel}
        />
      </div>

      <div className={`${styles.section} ${styles.rowWide}`}>
        <FinancialHealth
          isLoading={financialHealth.isLoading}
