          <InvestmentHoldingCard
            key={holding.id}
            holding={holding}
            onEdit={onEdit}
            onManageSip={onManageSip}
            onToggleActive={onToggleActive}
          />
        ))}
      </div>
    )}
  </section>
)

export default InvestmentHoldings
