    closeForm,
    register,
    errors,
    onSubmit,
    saving,
    categoryOptions,
    suggestion,
    suggestionCurrency,
    useSuggestion,
    pendingToggle,
    requestToggleActive,
    cancelToggleActive,
    confirmToggleActive,
    togglingActive,
  } = useActionBudget()

  return (
