        />
      )}

      {!isLoading && !isError && allBudgets.length > 0 && (
        <div className={styles.grid}>
          {budgets.map((budget) => (
            <BudgetCard key={budget.id} budget={budget} onEdit={openEditForm} onToggleActive={requestToggleActive} />
          ))}
